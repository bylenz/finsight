# Copy this file to .env (root) and fill in real values.
# Database
DATABASE_URL=postgresql+asyncpg://finsight:finsight@db:5432/finsight
POSTGRES_USER=finsight
POSTGRES_PASSWORD=finsight
POSTGRES_DB=finsight

# Auth
JWT_SECRET=change-me-in-production-please
JWT_ALGORITHM=HS256
JWT_EXPIRES_HOURS=24

# LLM
ANTHROPIC_API_KEY=your-anthropic-api-key

# App
BASE_CURRENCY=PEN
APP_ENV=development
LOG_LEVEL=INFO

# Frontend
BACKEND_URL=http://web:8000
