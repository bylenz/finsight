# Copy this file to .env (root) and fill in real values.
# Database
DATABASE_URL=postgresql+asyncpg://finsight:finsight@db:5432/finsight
POSTGRES_USER=finsight
POSTGRES_PASSWORD=finsight
POSTGRES_DB=finsight

# Auth
JWT_SECRET=change-me-in-production-please
JWT_ALGORITHM=HS256
JWT_EXPIRES_HOURS=24

# LLM — works with Anthropic Claude or any Anthropic-protocol-compatible provider.
#
# Anthropic (default):
ANTHROPIC_API_KEY=your-anthropic-api-key
# ANTHROPIC_BASE_URL=                          # leave blank for official Anthropic
# LLM_MODEL=claude-haiku-4-5-20251001          # default
#
# Z.ai GLM (Anthropic-compatible endpoint):
# ANTHROPIC_API_KEY=your-zai-api-key
# ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic
# LLM_MODEL=glm-4.5-air                        # haiku-class. Use glm-4.6 for sonnet-class.

# App
BASE_CURRENCY=PEN
APP_ENV=development
LOG_LEVEL=INFO

# Frontend
BACKEND_URL=http://web:8000
